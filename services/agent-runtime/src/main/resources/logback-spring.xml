<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>{"dateTime":"%date{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","serviceName":"agent-runtime","logLevel":"%level","threadName":"%thread","threadNumber":0,"className":"%logger{36}","message":"%replace(%msg){'"','\\\"'}","context":{"traceId":"%X{traceId:-na}","spanId":"%X{spanId:-na}"}}%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
